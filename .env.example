# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- Docker Compose (host ports are non-default on purpose) ---
POSTGRES_USER=chambaia
POSTGRES_PASSWORD=chambaia_dev
POSTGRES_DB=chambaia
POSTGRES_PORT=5442
REDIS_PORT=6382
API_PORT=5180

# --- Only needed for `docker compose --profile full up` (API in a container) ---
# 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_KEY=
ASPNETCORE_ENVIRONMENT=Production
SEED_ENABLED=false
SEED_DEMO_PASSWORD=

# --- API running with `dotnet run` (Development) reads apps/api/src/ChambaIA.Api/appsettings.Development.json,
#     which points to the compose ports above. Override anything with double-underscore variables, e.g.:
# ConnectionStrings__Postgres=Host=localhost;Port=5442;Database=chambaia;Username=chambaia;Password=chambaia_dev
# ConnectionStrings__Redis=localhost:6382,abortConnect=false
# Jwt__Key=<32+ random chars>   (in Development a random key is generated into apps/api/src/ChambaIA.Api/.dev/jwt.key)
# Seed__Enabled=true
# Seed__DemoPassword=<choose a password for the demo user>

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5180

# --- Embeddings (fase 4). Provider "None" = el producto funciona sin vectores (modo sin IA). ---
# Ollama local:   Embeddings__Provider=Ollama   Embeddings__BaseUrl=http://localhost:11434
# Ollama remoto (p. ej. tu servidor Contabo) SOLO por red privada/túnel o detrás de un proxy con token:
# Embeddings__Provider=Ollama
# Embeddings__BaseUrl=https://ollama.tu-dominio.com
# Embeddings__ApiKey=<token que verifica tu proxy>
# Embeddings__Model=bge-m3
# --- IA (fase 8). Apagada por defecto: sin esto el producto funciona igual. Ver docs/AI-COSTS.md ---
# Ai__Enabled=true
# Ai__Providers__local__Type=Ollama
# Ai__Providers__local__Model=llama3.2
# Ai__Providers__local__TimeoutSeconds=120
# Ai__Routes__JobExtraction__0=local
# Ai__Providers__barato__ApiKey=<SECRETO: solo aquí o en tu gestor de secretos>
# Admin__Emails__0=tu-correo@ejemplo.com

# --- Notificaciones push (fase 6). "None" = solo bandeja dentro de la app. ---
# Requiere proyecto EAS + credenciales FCM (ver docs/NOTIFICATIONS.md). El token de acceso de Expo es opcional y SECRETO.
# Push__Provider=Expo
# Push__AccessToken=<token de acceso de Expo>
OLLAMA_PORT=11434
