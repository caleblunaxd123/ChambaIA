{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "chambaia",
    "Audience": "chambaia-mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10
  },
  "Cors": {
    "Origins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Embeddings": {
    "Provider": "None",
    "BaseUrl": "http://localhost:11434",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "BatchSize": 16,
    "TimeoutSeconds": 60,
    "InteractiveTimeoutSeconds": 8
  },
  "Push": {
    "Provider": "None",
    "BaseUrl": "https://exp.host",
    "UtcOffsetHours": -5,
    "QuietStartHour": 22,
    "QuietEndHour": 7,
    "DailyDigestHour": 8,
    "MaxPerDay": 4,
    "InstantMinGapMinutes": 30
  }
}
