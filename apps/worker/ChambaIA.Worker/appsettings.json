{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Warning",
        "System": "Warning"
      }
    }
  },
  "Worker": {
    "HeartbeatCron": "0 0/1 * * * ?",
    "IngestionCron": "0 0/30 * * * ?"
  },
  "Ingestion": {
    "IncludeDemo": false,
    "StaleAfterDays": 7,
    "Feeds": []
  }
}
