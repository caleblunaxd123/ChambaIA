{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Warning",
        "System": "Warning"
      }
    }
  },
  "Worker": {
    "HeartbeatCron": "0 0/1 * * * ?",
    "IngestionCron": "0 0/30 * * * ?",
    "EmbeddingCron": "0 0/10 * * * ?"
  },
  "Ingestion": {
    "IncludeDemo": false,
    "StaleAfterDays": 7,
    "Feeds": []
  },
  "Embeddings": {
    "Provider": "None",
    "BaseUrl": "http://localhost:11434",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "BatchSize": 16,
    "TimeoutSeconds": 60,
    "InteractiveTimeoutSeconds": 8
  }
}
